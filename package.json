      "members/moron/parts/cleaned/hair-back-generated-v16.png",
      "members/moron/parts/cleaned/hair-front-generated-v16.png",
      "members/moron/parts/cleaned/hair-upper-generated-v17.png",
      "members/moron/parts/cleaned/irises-v2.png",
      "members/muto/parts/cleaned/base.png",
      "members/muto/parts/cleaned/eye-shapes-muto-single-v5.png",
      "members/muto/parts/cleaned/hair-back-generated-v16.png",
      "members/muto/parts/cleaned/hair-front-generated-v16.png",
      "members/muto/parts/cleaned/hair-upper-generated-v16.png",
      "members/muto/parts/cleaned/irises-v2.png",
      "members/raft/parts/cleaned/base.png",
      "members/raft/parts/cleaned/hair-back-1-v13.png",
      "members/raft/parts/cleaned/hair-back-2-v13.png",
      "members/raft/parts/cleaned/hair-back-3-v13.png",
      "members/raft/parts/cleaned/hair-front-1-v13.png",
      "members/raft/parts/cleaned/hair-front-2-v13.png",
      "members/raft/parts/cleaned/hair-front-3-v13.png",
      "members/raft/parts/cleaned/hair-upper-1-v13.png",
      "members/raft/parts/cleaned/hair-upper-2-v13.png",
      "members/raft/parts/cleaned/hair-upper-3-v13.png",
      "members/shared/cleaned/eye-shapes-6-v2.png",
      "members/shared/cleaned/eye-whites-v2.png",
      "members/shared/cleaned/eyebrows.png",
      "members/shared/cleaned/irises-v2.png",
      "members/shared/cleaned/mouth-speech-16-v3.png",
      "members/shared/cleaned/rig-atlas.png",
      "members/shared/accessories/gaming-sunglasses-handdrawn-v2.png",
      "members/shared/accessories/mask-white-handdrawn-v2.png",
      "members/shared/accessories/mask-black-handdrawn-v2.png",
      "members/shared/accessories/disguise-glasses-handdrawn-v2.png",
      "members/tanutsuna/parts/cleaned/base.png",
      "members/tanutsuna/parts/rig-v3/hair-back-full-v3-dark-alpha.png",
      "members/tanutsuna/parts/rig-v3/hair-front-assembled-v3-alpha.png",
      "members/week/!mouth.png",
      "members/week/body.png",
      "members/week/head.png",
      "members/week/left.png",
