      "members/gyoza/parts/arm-left.png",
      "members/gyoza/parts/arm-right.png",
      "members/gyoza/parts/body-torso.png",
      "members/gyoza/parts/eye-left-closed.png",
      "members/gyoza/parts/eye-left-half.png",
      "members/gyoza/parts/eye-left-open.png",
      "members/gyoza/parts/eye-left-smile.png",
      "members/gyoza/parts/eye-right-closed.png",
      "members/gyoza/parts/eye-right-half.png",
      "members/gyoza/parts/eye-right-open.png",
      "members/gyoza/parts/eye-right-smile.png",
      "members/gyoza/parts/hand-left.png",
      "members/gyoza/parts/hand-right.png",
      "members/gyoza/parts/head-base.png",
      "members/gyoza/parts/head-crease-left.png",
      "members/gyoza/parts/head-crease-right.png",
      "members/gyoza/parts/head-highlight.png",
      "members/gyoza/parts/head-shadow-left.png",
      "members/gyoza/parts/leg-left.png",
      "members/gyoza/parts/leg-right.png",
      "members/gyoza/parts/mouth-closed.png",
      "members/gyoza/parts/mouth-frown.png",
      "members/gyoza/parts/mouth-large.png",
      "members/gyoza/parts/mouth-medium.png",
      "members/gyoza/parts/mouth-small.png",
      "members/gyoza/parts/mouth-smile-closed.png",
      "members/gyoza/parts/mouth-smile-open.png",
      "members/gyoza/parts/mouth-surprised.png",
      "members/gyoza/parts/neck.png",
