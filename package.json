{
  "name": "muzan-raft-vtuber-studio",
  "version": "1.1.21",
  "description": "Camera-tracked VTuber studio for OBS",
  "author": "Raft3921",
  "main": "bootstrap.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "desktop": "electron .",
    "check": "node scripts/audit-assets.mjs",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "jp.muzannoraft.vtuberstudio",
    "productName": "RAFT Vtuber",
    "asar": true,
    "icon": "members/icon/icon.png",
    "files": [
      "bootstrap.cjs",
      "desktop.mjs",
      "server.mjs",
      "index.html",
      "studio.css",
      "members/**/*.html",
      "members/**/*.js",
      "members/**/*.css",
      "members/icon/icon.png",
      "members/mai/parts/cleaned/base.png",
