      "members/yansan/parts/cleaned/hair-back-generated-v16.png",
      "members/yansan/parts/cleaned/hair-front-generated-v16.png",
      "members/yansan/parts/cleaned/hair-upper-generated-v16.png",
      "members/yansan/parts/cleaned/irises-v2.png",
      "config/**/*",
      "assets-manifest.json",
      "version.json",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "RAFT-Vtuber-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RAFT-Vtuber-${version}-windows-${arch}.${ext}"
    },
    "dmg": {
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Raft3921",
        "repo": "Vtuber"
      }
    ]
  }
}
